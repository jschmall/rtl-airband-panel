# Copy to .env and adjust as needed. Only the settings you want to override
# need to be present; everything else falls back to its default (see README).

RTL_PANEL_INSTANCES_DIR=/etc/rtl-airband-panel/instances
RTL_PANEL_UNIT_DIR=/etc/systemd/system
RTL_PANEL_RTL_AIRBAND_BIN=/usr/local/bin/rtl_airband
RTL_PANEL_SYSTEMD_MODE=mock
RTL_PANEL_SUDO_UNIT_PREFIX=
RTL_PANEL_PORT=3000
RTL_PANEL_HOST=127.0.0.1
RTL_PANEL_LOG_LEVEL=info
# RTL_PANEL_LOG_FILE=/var/log/rtl-airband-panel/panel.log
RTL_PANEL_STATS_DB_PATH=/home/youruser/.rtl-airband-panel/stats.db
RTL_PANEL_STATS_POLL_INTERVAL_MS=15000
RTL_PANEL_STATS_RETENTION_DAYS=7
RTL_PANEL_STATS_PRUNE_INTERVAL_MS=3600000

# --- Rust panel only (rust branch) ---------------------------------------
# HTTP Basic auth. Required when RTL_PANEL_HOST isn't a loopback address,
# unless RTL_PANEL_ALLOW_UNAUTHENTICATED=true.
# RTL_PANEL_USERNAME=admin
# RTL_PANEL_PASSWORD=change-me
# RTL_PANEL_ALLOW_UNAUTHENTICATED=false
# User=/Group= written into generated instance units when an instance has
# no per-instance override. Set to the panel's own user so live apply's
# control socket (same-UID only) accepts the panel.
# RTL_PANEL_DEFAULT_SERVICE_USER=rtl-airband-panel
# RTL_PANEL_DEFAULT_SERVICE_GROUP=rtl-airband-panel
# RTL_PANEL_CONTROL_SOCKET_TIMEOUT_MS=8000
# Serve the frontend from a directory instead of the copy built into the binary.
# RTL_PANEL_FRONTEND_DIST=/path/to/frontend/dist
