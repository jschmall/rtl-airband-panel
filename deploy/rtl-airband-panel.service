# Example unit for running the panel binary (rtl-airband-panel) under systemd.
#
# Distinct from the per-instance <name>.service units the panel generates
# for RTLSDR-Airband itself; this one runs the panel. Replacing an older
# Node.js install of the panel? See DEPLOYMENT.md, "Migrating from the
# Node.js panel".
#
# Copy to /etc/systemd/system/rtl-airband-panel.service, adjust User= and
# the paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now rtl-airband-panel

[Unit]
Description=rtl-airband-panel web control panel
Documentation=https://github.com/jschmall/rtl-airband-panel
After=network.target

[Service]
Type=simple
User=rtl-airband-panel
SyslogIdentifier=rtl-airband-panel
# KEY=VALUE settings, same names as .env.example. Keep it mode 0600 if it
# holds RTL_PANEL_PASSWORD. A leading "-" makes a missing file not an error.
EnvironmentFile=-/etc/rtl-airband-panel/panel.env
ExecStart=/usr/local/bin/rtl-airband-panel
Restart=on-failure
RestartSec=5

# Optional hardening once the panel works: restrict writes to what it needs
# (instances dir, unit dir in sudo mode, stats DB). Adjust to your settings.
# ProtectSystem=strict
# ReadWritePaths=/etc/rtl-airband-panel/instances /etc/systemd/system /home/rtl-airband-panel/.rtl-airband-panel

[Install]
WantedBy=multi-user.target
